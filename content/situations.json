{"situations":[{"id":"sit_doctor","title":"У врача","dialogs":[{"title":"Запись к врачу","turns":[{"who":"Секретарь","he":"קֻפַּת חוֹלִים, שָׁלוֹם.","ru":"Больничная касса, здравствуйте.","opts":[{"he":"שָׁלוֹם, אֲנִי רוֹצָה לִקְבֹּעַ תּוֹר לְרוֹפֵא.","ru":"Здравствуйте, я хочу записаться к врачу.","ok":true},{"he":"תּוֹדָה, לְהִתְרָאוֹת.","ru":"Спасибо, до свидания.","why":"Разговор только начинается."},{"he":"רְפוּאָה שְׁלֵמָה!","ru":"Выздоравливайте!","why":"Так желают выздоровления больному, а не начинают разговор."}]},{"who":"Секретарь","he":"מָה הַבְּעָיָה?","ru":"В чём проблема?","opts":[{"he":"כּוֹאֵב לִי הָרֹאשׁ וְיֵשׁ לִי חֹם.","ru":"У меня болит голова и температура.","ok":true},{"he":"אֲנִי לוֹמֶדֶת עִבְרִית בָּאֻלְפָּן.","ru":"Я учу иврит в ульпане."},{"he":"זֶה יָקָר מִדַּי.","ru":"Это слишком дорого."}]},{"who":"Секретарь","he":"יֵשׁ תּוֹר מָחָר בְּעֶשֶׂר. מַתְאִים לָךְ?","ru":"Есть запись на завтра в десять. Вам подходит?","opts":[{"he":"כֵּן, מַתְאִים לִי. תּוֹדָה רַבָּה!","ru":"Да, подходит. Большое спасибо!","ok":true},{"he":"לֹא, אֲנִי רַק מִסְתַּכֶּלֶת.","ru":"Нет, я просто смотрю.","why":"Это фраза для магазина."},{"he":"נָעִים מְאוֹד!","ru":"Очень приятно!","why":"Так говорят при знакомстве."}]}]},{"title":"У врача","turns":[{"who":"Врач","he":"מָה כּוֹאֵב לָךְ?","ru":"Что у вас болит?","opts":[{"he":"כּוֹאֵב לִי הָרֹאשׁ כְּבָר שְׁלוֹשָׁה יָמִים.","ru":"У меня болит голова уже три дня.","ok":true},{"he":"אֲנִי בְּחֹפֶשׁ עַד יוֹם רִאשׁוֹן.","ru":"Я в отпуске до воскресенья."},{"he":"כַּמָּה זֶה עוֹלֶה?","ru":"Сколько это стоит?"}]},{"who":"Врач","he":"אֲנִי נוֹתֵן לָךְ מִרְשָׁם. כַּדּוּר פַּעֲמַיִם בַּיּוֹם, אַחֲרֵי הָאֹכֶל.","ru":"Я выпишу вам рецепт. Таблетка два раза в день, после еды.","opts":[{"he":"בְּסֵדֶר. אֵיפֹה יֵשׁ בֵּית מִרְקַחַת?","ru":"Хорошо. Где есть аптека?","ok":true},{"he":"אֶפְשָׁר לִמְדֹּד?","ru":"Можно примерить?","why":"Это фраза для магазина одежды."},{"he":"יֵשׁ פְּקָקִים.","ru":"Пробки."}]},{"who":"Врач","he":"בַּקּוֹמ