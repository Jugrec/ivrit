{"exams":[{"id":"aleph","title":"Контрольная: уровень Алеф","after":"m15l5","parts":[{"id":"text","title":"Понимание текста","items":[{"type":"choice","prompt":"Ответьте по тексту","options":["בְּבַנְק","בָּאֻלְפָּן","בַּמָּלוֹן"],"answer":0,"he":"אֵיפֹה מִיכָאֵל עוֹבֵד?"},{"type":"choice","prompt":"Ответьте по тексту","options":["בְּאוֹטוֹבּוּס","בִּמְכוֹנִית","בְּמָטוֹס"],"answer":0,"he":"אֵיךְ הֵם נָסְעוּ לְאֵילַת?"},{"type":"choice","prompt":"Ответьте по тексту","options":["הֵם שָׂחוּ בַּיָּם","הֵם נָחוּ בַּמָּלוֹן","הֵם אָכְלוּ בְּמִסְעָדָה"],"answer":0,"he":"מָה הֵם עָשׂוּ כָּל בֹּקֶר?"},{"type":"choice","prompt":"Ответьте по тексту","options":["אֵצֶל סָבְתָא","אֵצֶל אִמָּא","אֵצֶל חֲבֵרָה"],"answer":0,"he":"אֵצֶל מִי נוֹעָה נִשְׁאֲרָה?"},{"type":"choice","prompt":"Ответьте по тексту","options":["מַתָּנָה לַבַּת שֶׁלּוֹ","כַּרְטִיס לָאוֹטוֹבּוּס","בְּגָדִים לְאִשְׁתּוֹ"],"answer":0,"he":"מָה מִיכָאֵל קָנָה בַּיּוֹם הָאַחֲרוֹן?"},{"type":"choice","prompt":"Верно или неверно?","options":["לֹא נָכוֹן","נָכוֹן"],"answer":0,"he":"בְּאֵילַת הָיָה קַר."},{"type":"choice","prompt":"Верно или неверно?","options":["נָכוֹן","לֹא נָכוֹן"],"answer":0,"he":"בַּקַּיִץ הַבָּא נוֹעָה תִּסַּע עִם הַהוֹרִים לַכִּנֶּרֶת."}],"textTitle":"הַחֹפֶשׁ שֶׁל מִיכָאֵל","text":["מִיכָאֵל גָּר בְּתֵל אָבִיב. הוּא עוֹבֵד בְּבַנְק וְלוֹמֵד עִבְרִית בָּעֶרֶב.","בַּשָּׁבוּעַ שֶׁעָבַר הָיָה לוֹ חֹפֶשׁ, וְהוּא נָסַע עִם אִשְׁתּוֹ לְאֵילַת. הֵם נָסְעוּ בְּאוֹטוֹבּוּס חָמֵשׁ שָׁעוֹת.","בְּאֵילַת הָיָה חַם מְאוֹד. כָּל בֹּקֶר הֵם שָׂחוּ בַּיָּם, וּבַצָּהֳרַיִם הֵם נָחוּ בַּמָּלוֹן. בָּעֶרֶב הֵם אָכְלוּ בְּמִסְעָדָה וְטִיְּלוּ לְיַד הַיָּם.","בַּיּוֹם הָאַחֲרוֹן מִיכָאֵל קָנָה מַתָּנָה לַבַּת שֶׁלּוֹ, נוֹעָה. נוֹעָה בַּת שֵׁשׁ, וְהִיא נִשְׁאֲרָה אֵצֶל סָבְתָא בְּחֵיפָה.","עַכְשָׁו מִיכָאֵל שׁוּב בָּעֲבוֹדָה. הוּא עָיֵף, אֲבָל שָׂמֵחַ. בַּקַּיִץ הַבָּא הוּא רוֹצֶה לִנְסֹעַ לַכִּנֶּרֶת, וְנוֹעָה תִּסַּע אִתָּם."]},{"id":"grammar","title":"Грамматика","items":[{"type":"gap","prompt":"Глагол «писать», настоящее время","he":"הִיא ___ מִכְתָּב.","accept":["כּוֹתֶבֶת"]},{"type":"gap","prompt":"Глагол «жить», прошедшее время, я","he":"אֲנִי ___ בְּמוֹסְקְבָה.","accept":["גַּרְתִּי"]},{"type":"gap","prompt":"Глагол «ехать», будущее время, мы","he":"מָחָר אֲנַחְנוּ ___ לִירוּשָׁלַיִם.","accept":["נִסַּע","ניסע"]},{"type":"gap","prompt":"«У меня есть»","he":"יֵשׁ ___ אָח וְאָחוֹת.","accept":["לִי"]},{"type":"gap","prompt":"«У него нет»","he":"___ לוֹ מְכוֹנִית.","accept":["אֵין"]},{"type":"gap","prompt":"Глагол «хотеть», настоящее время, они","he":"הֵם ___ לֶאֱכֹל.","accept":["רוֹצִים"]},{"type":"gap","prompt":"Глагол «быть», прошедшее время, она","he":"הִיא ___ בַּבַּיִת.","accept":["הָיְתָה","הייתה"]},{"type":"gap","prompt":"«Три дочери»","he":"יֵשׁ לָהֶם ___ בָּנוֹת.","accept":["שָׁלוֹשׁ"]},{"type":"gap","prompt":"«Три сына»","he":"יֵשׁ לָהֶם ___ בָּנִים.","accept":["שְׁלוֹשָׁה"]},{"type":"gap","prompt":"«Моя книга»","he":"זֶה הַסֵּפֶר ___.","accept":["שֶׁלִּי"]},{"type":"gap","prompt":"Предлог перед определённым дополнением","he":"אֲנִי רוֹאָה ___ הַמּוֹרֶה.","accept":["אֶת"]},{"type":"gap","prompt":"Глагол «любить», настоящее время, я (ж.)","he":"אֲנִי ___ מוּזִיקָה.","accept":["אוֹהֶבֶת"]},{"type":"gap","prompt":"Глагол «идти», будущее время, я","he":"מָחָר אֲנִי ___ לַבַּנְק.","accept":["אֵלֵךְ"]},{"type":"choice","prompt":"Как сказать «этот большой дом»?","options":["הַבַּיִת הַגָּדוֹל הַזֶּה","הַבַּיִת גָּדוֹל הַזֶּה","בַּיִת הַגָּדוֹל הַזֶּה"],"answer":0},{"type":"choice","prompt":"Как сказать «мы были в Хайфе»?","options":["הָיִינוּ בְּחֵיפָה","הָיוּ בְּחֵיפָה","נִהְיֶה בְּחֵיפָה"],"answer":0}]},{"id":"vocab","title":"Словарь","items":[{"type":"choice","prompt":"Что значит это слово?","options":["кухня","спальня","балкон"],"answer":0,"he":"מִטְבָּח"},{"type":"choice","prompt":"Что значит это слово?","options":["вчера","завтра","сегодня"],"answer":0,"he":"אֶתְמוֹל"},{"type":"choice","prompt":"Противоположное по смыслу","options":["קָטָן","חָדָשׁ","יָפֶה"],"answer":0,"he":"גָּדוֹל"},{"type":"choice","prompt":"Противоположное по смыслу","options":["חַם","טוֹב","רָחוֹק"],"answer":0,"he":"קַר"},{"type":"choice","prompt":"Какое слово подходит?","options":["קָפֶה","לֶחֶם","כִּסֵּא"],"answer":0,"he":"אֲנִי שׁוֹתָה ___ בַּבֹּקֶר."}]}],"writing":{"title":"Мои выходные","task":"Напишите 50-70 слов о том, что вы делали в прошлые выходные и что будете делать в следующие.","use":"прошедшее и будущее время, [[אֶתְמוֹל]], [[אַחַר כָּךְ]], [[בַּשָּׁבוּעַ הַבָּא]], [[כִּי]]"}},{"id":"bet","title":"Контрольная: уровень Бет","after":"m23l5","parts":[{"id":"text","title":"Понимание текста","items":[{"type":"choice","prompt":"Ответьте по тексту","options":["הַדִּירָה הָיְתָה קְטַנָּה מִדַּי","הַדִּירָה הָיְתָה יְקָרָה מִדַּי","הַשְּׁכוּנָה הָיְתָה רוֹעֶשֶׁת"],"answer":0,"he":"לָמָּה דָּנָה וְדָוִד הֶחְלִיטוּ לַעֲבֹר דִּירָה?"},{"type":"choice","prompt":"Ответьте по тексту","options":["כִּמְעַט שְׁלוֹשָׁה שָׁבוּעוֹת","חֹדֶשׁ","שָׁנָה"],"answer":0,"he":"כַּמָּה זְמַן הֵם חִפְּשׂוּ דִּירָה?"},{"type":"choice","prompt":"Ответьте по тексту","options":["מַעֲלִית וַחֲנִיָּה","גִּנָּה וּבְרֵכָה","רַק מַעֲלִית"],"answer":0,"he":"מָה יֵשׁ בַּבִּנְיָן הֶחָדָשׁ?"},{"type":"choice","prompt":"Ответьте по тексту","options":["הַחֲבֵרִים","בַּעַל הַדִּירָה","הַשְּׁכֵנִים"],"answer":0,"he":"מִי עָזַר בְּיוֹם הַמַּעֲבָר?"},{"type":"choice","prompt":"Ответьте по тексту","options":["שֶׁהֵם לֹא יַעַבְרוּ דִּירָה שׁוּב בְּקָרוֹב","שֶׁהַדִּירָה קְטַנָּה מִדַּי","שֶׁהוּא רוֹצֶה עוֹד פִּיצָה"],"answer":0,"he":"מָה דָּוִד אָמַר בָּעֶרֶב?"},{"type":"choice","prompt":"Верно или неверно?","options":["לֹא נָכוֹן","נָכוֹן"],"answer":0,"he":"שְׂכַר הַדִּירָה בַּדִּירָה הַחֲדָשָׁה זוֹל יוֹתֵר."},{"type":"choice","prompt":"Верно или неверно?","options":["נָכוֹן","לֹא נָכוֹן"],"answer":0,"he":"הַדִּירָה הַחֲדָשָׁה לֹא רְחוֹקָה מֵהַגַּן."}],"textTitle":"דִּירָה חֲדָשָׁה","text":["לִפְנֵי חֹדֶשׁ דָּנָה וְדָוִד הֶחְלִיטוּ לַעֲבֹר דִּירָה. הַדִּירָה הַיְּשָׁנָה שֶׁלָּהֶם הָיְתָה קְטַנָּה מִדַּי, כִּי לִפְנֵי שָׁנָה נוֹלַד לָהֶם בֵּן.","הֵם חִפְּשׂוּ דִּירָה כִּמְעַט שְׁלוֹשָׁה שָׁבוּעוֹת. בַּסּוֹף הֵם מָצְאוּ דִּירַת אַרְבָּעָה חֲדָרִים בִּשְׁכוּנָה שְׁקֵטָה, לֹא רָחוֹק מִגַּן הַיְּלָדִים.","בַּעַל הַדִּירָה הִסְבִּיר לָהֶם שֶׁהַבִּנְיָן חָדָשׁ וְשֶׁיֵּשׁ בּוֹ מַעֲלִית וַחֲנִיָּה. שְׂכַר הַדִּירָה יָקָר יוֹתֵר, אֲבָל דָּנָה הִרְגִּישָׁה שֶׁזֶּה הַבַּיִת הַנָּכוֹן.","בְּיוֹם הַמַּעֲבָר כָּל הַחֲבֵרִים בָּאוּ לַעֲזֹר. הֵם הֶעֱבִירוּ אַרְגָּזִים, סִדְּרוּ אֶת הַמִּטְבָּח וְאֶת הַחֶדֶר שֶׁל הַתִּינוֹק.","בָּעֶרֶב כֻּלָּם יָשְׁבוּ בַּמִּרְפֶּסֶת, אָכְלוּ פִּיצָה וְצָחֲקוּ. דָּוִד אָמַר: \"בַּשָּׁנָה הַבָּאָה אֲנַחְנוּ לֹא עוֹבְרִים דִּירָה!\"","עַכְשָׁו הַבֵּן שֶׁלָּהֶם כְּבָר הוֹלֵךְ לַגַּן הֶחָדָשׁ, וְדָנָה מַכִּירָה אֶת כָּל הַשְּׁכֵנִים."]},{"id":"grammar","title":"Грамматика","items":[{"type":"gap","prompt":"Глагол «объяснять», прошедшее время, она","he":"הַמּוֹרָה ___ אֶת הַשְּׁאֵלָה.","accept":["הִסְבִּירָה"]},{"type":"gap","prompt":"Глагол «приглашать», будущее время, мы","he":"בְּשַׁבָּת ___ חֲבֵרִים.","accept":["נַזְמִין"]},{"type":"gap","prompt":"Глагол «одеваться», настоящее время, она","he":"הַיַּלְדָּה ___ לְבַד.","accept":["מִתְלַבֶּשֶׁת"]},{"type":"gap","prompt":"Глагол «звонить», прошедшее время, я","he":"אֶתְמוֹל ___ לְאִמָּא.","accept":["הִתְקַשַּׁרְתִּי"]},{"type":"gap","prompt":"Глагол «встречаться», будущее время, мы","he":"מָחָר ___ בְּבֵית הַקָּפֶה.","accept":["נִפָּגֵשׁ","ניפגש"]},{"type":"gap","prompt":"Глагол «говорить», прошедшее время, они","he":"הֵם ___ עִם הַמְּנַהֵל.","accept":["דִּבְּרוּ","דיברו"]},{"type":"gap","prompt":"Глагол «писать», будущее время, она","he":"הִיא ___ מִכְתָּב מָחָר.","accept":["תִּכְתֹּב","תכתוב"]},{"type":"gap","prompt":"Смихут: «две школы»","he":"בָּעִיר יֵשׁ שְׁנֵי ___ סֵפֶר.","accept":["בָּתֵּי"]},{"type":"gap","prompt":"«Я думаю о тебе (ж.)»","he":"אֲנִי חוֹשֵׁב ___.","accept":["עָלַיִךְ","עלייך"]},{"type":"gap","prompt":"«Я получила письмо от неё»","he":"קִבַּלְתִּי מִכְתָּב ___.","accept":["מִמֶּנָּה"]},{"type":"gap","prompt":"«Я работаю с ними»","he":"אֲנִי עוֹבֶדֶת ___.","accept":["אִתָּם","איתם"]},{"type":"gap","prompt":"«Я живу на третьем этаже»","he":"אֲנִי גָּרָה בַּקּוֹמָה ___.","accept":["הַשְּׁלִישִׁית"]},{"type":"choice","prompt":"Как сказать «квартира тех студентов»?","options":["דִּירַת הַסְּטוּדֶנְטִים","הַדִּירַת סְטוּדֶנְטִים","הַדִּירָה הַסְּטוּדֶנְטִים"],"answer":0},{"type":"choice","prompt":"Как сказать «она выше меня»?","options":["הִיא גְּבוֹהָה מִמֶּנִּי","הִיא גְּבוֹהָה מֵאֲנִי","הִיא גְּבוֹהָה שֶׁלִּי"],"answer":0},{"type":"choice","prompt":"Какое слово подходит?","options":["כִּי","אִם","אֲבָל"],"answer":0,"he":"לֹא בָּאתִי לָעֲבוֹדָה, ___ הָיִיתִי חוֹלָה."}]},{"id":"vocab","title":"Словарь","items":[{"type":"choice","prompt":"Что значит это слово?","options":["лифт","балкон","подъезд"],"answer":0,"he":"מַעֲלִית"},{"type":"choice","prompt":"Что значит это слово?","options":["решать","объяснять","приглашать"],"answer":0,"he":"לְהַחְלִיט"},{"type":"choice","prompt":"Противоположное по смыслу","options":["רוֹעֵשׁ","נָקִי","רָחוֹק"],"answer":0,"he":"שָׁקֵט"},{"type":"choice","prompt":"Какое слово подходит?","options":["פָּתַח","סָגַר","שָׁבַר"],"answer":0,"he":"הוּא ___ אֶת הַחַלּוֹן, כִּי הָיָה חַם."},{"type":"choice","prompt":"Близкое по смыслу","options":["בִּמְהִירוּת","לְאַט","פִּתְאוֹם"],"answer":0,"he":"מַהֵר"}]}],"writing":{"title":"Письмо другу","task":"Напишите письмо другу или подруге (90-120 слов): где вы живёте сейчас, что изменилось за последний год и какие у вас планы.","use":"прошедшее, настоящее и будущее время, hифъиль и hитпаэль, [[כִּי]], [[לָכֵן]], [[אֲבָל]], предлоги с окончаниями"}}]}